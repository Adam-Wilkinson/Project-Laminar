<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Laminar.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:FileViewModel"
             x:Class="Laminar.Avalonia.Views.FileView">
    <Border Classes="UiLayer">
        <Panel Classes="UiLayer">
            <ContentControl Content="{Binding CurrentFileViewModel}"
                            IsVisible="{Binding CurrentFileViewModel, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ClipToBounds="True"/>
            <TextBlock IsVisible="{Binding CurrentFileViewModel, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Open files will appear here"
                       Opacity="0.4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="h2"/>
        </Panel>
    </Border>
</UserControl>
