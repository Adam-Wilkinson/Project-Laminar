<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Laminar.Avalonia.ViewModels"
             xmlns:c="using:Laminar.Avalonia.Controls"
             xmlns:t="using:Laminar.Avalonia.ToolSystem"
             xmlns:fe="using:Laminar.Contracts.Storage.FileExplorer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Laminar.Avalonia.Views.FileNavigatorItemView"
             x:DataType="vm:FileNavigatorItemViewModel"
             t:ToolMenu.QuickAccessKey="{Binding Type.ItemTypeName, 
             Converter={StaticResource ToStringConverter}}">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <t:Toolbox x:Key="ScriptContextMenu" DataType="vm:FileNavigatorItemViewModel" NameKey="Script">
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Open"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Rename"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.ToggleEnabled"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Delete"/>
            </t:Toolbox>
            
            <t:Toolbox x:Key="FolderContextMenu" DataType="vm:FileNavigatorItemViewModel" NameKey="Folder">
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Rename"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.ToggleEnabled"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Delete"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.AddChild"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.OpenInFileBrowser"/>
            </t:Toolbox>
            
            <t:Toolbox x:Key="UnknownFileContextMenu" DataType="vm:FileNavigatorItemViewModel" NameKey="File">
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Rename"/>
                <StaticResource ResourceKey="Tools.FileSystem.StorageItem.Delete"/>
            </t:Toolbox>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <t:ToolMenu.ContextToolbox>
        <MultiBinding Converter="{StaticResource SwitchConverter}">
            <Binding Path="Type"/>
            <Binding Source="{StaticResource FolderContextMenu}" Converter="{StaticResource SwitchItemConverter}" ConverterParameter="{x:Static fe:FileSystemItemType.Folder}"/>
            <Binding Source="{StaticResource ScriptContextMenu}" Converter="{StaticResource SwitchItemConverter}" ConverterParameter="{x:Static fe:FileSystemItemType.Script}"/>
            <Binding Source="{StaticResource UnknownFileContextMenu}" Converter="{StaticResource SwitchItemConverter}" ConverterParameter="{x:Static fe:FileSystemItemType.Unknown}"/>
        </MultiBinding>
    </t:ToolMenu.ContextToolbox>
    
    <DockPanel HorizontalAlignment="Stretch"
               Background="Transparent"
               VerticalAlignment="Stretch"
               IsHitTestVisible="True">
        <ItemsControl DockPanel.Dock="Right"
                      Height="{Binding #ItemNameLabel.Bounds.Height}"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Right"
                      ClipToBounds="True"
                      ItemsSource="{t:QuickAccess {CompiledBindingExtension Path=Type.ItemTypeName, DataType=vm:FileNavigatorItemViewModel, Converter={StaticResource ToStringConverter}}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <c:EditableLabel Name="ItemNameLabel"
                         VerticalAlignment="Center"
                         Text="{Binding Name, Mode=TwoWay}"
                         DisallowedChars="{x:Static vm:FileNavigatorItemViewModel.InvalidFileNameChars}"
                         IsBeingEdited="{Binding NameBeingSet, Mode=TwoWay}"
                         Padding="3"/>
    </DockPanel>
</UserControl>
