<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Laminar.Avalonia.ViewModels"
             xmlns:sam="using:Laminar.Avalonia.SelectAndMove"
             xmlns:m="using:Laminar.Avalonia.Markup"
             xmlns:dd="using:Laminar.Avalonia.DragDrop"
             xmlns:t="using:Laminar.Avalonia.ToolSystem"
             xmlns:g="using:Laminar.Avalonia.Gestures"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Laminar.Avalonia.Views.ScriptEditorView"
             x:DataType="vm:ScriptEditorViewModel"
             Background="Transparent"
             IsHitTestVisible="True">
    <UserControl.Resources>
        <m:ConnectorRegistry x:Key="{x:Static m:ConnectorRegistry.Key}"/>
    </UserControl.Resources>
    
    <t:ToolMenu.ContextToolbox>
        <t:Toolbox NameKey="Script Editor" DataType="vm:ScriptEditorViewModel">
            <StaticResource ResourceKey="Tools.ScriptEditor.DeleteSelection"/>
            <StaticResource ResourceKey="Tools.Edit.Copy"/>
            <StaticResource ResourceKey="Tools.Edit.Paste"/>
        </t:Toolbox>
    </t:ToolMenu.ContextToolbox>
    
    <sam:SelectAndMove Name="SelectAndMove"
                       ItemsSource="{Binding VisualElements}"
                       SelectionModel="{Binding SelectionModel}"
                       ViewZoom="{Binding Zoom.Value, Mode=TwoWay}"
                       ViewTranslateX="{Binding PanX, Mode=TwoWay}"
                       ViewTranslateY="{Binding PanY, Mode=TwoWay}"
                       ClipToBounds="True"
                       dd:DropTargetHandler.DropPositionRelativeTo="{Binding $self.TransformRoot}"
                       dd:DropTargetHandler.DropTarget="{Binding}"
                       dd:DropTargetHandler.AnimateHomeOnDrop="False">
        <sam:SelectAndMove.ItemTemplate>
            <DataTemplate DataType="vm:ScriptEditorItemModel">
                <ContentControl Content="{Binding CoreElement}"
                                ClipToBounds="False"/>
            </DataTemplate>
        </sam:SelectAndMove.ItemTemplate>
        
        <sam:SelectAndMove.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas>
                    <Canvas.GestureRecognizers>
                        <g:MakeConnectionGesture ConnectionInteractionHandler="{Binding}"/>
                    </Canvas.GestureRecognizers>
                </Canvas>
            </ItemsPanelTemplate>
        </sam:SelectAndMove.ItemsPanel>
        
        <sam:SelectAndMove.Styles>
            <Style Selector="sam|SelectAndMoveItem" x:DataType="vm:ScriptEditorItemModel">
                <Setter Property="Left" Value="{Binding Left, Mode=TwoWay}"/>
                <Setter Property="Top" Value="{Binding Top, Mode=TwoWay}"/>
                <Setter Property="ClipToBounds" Value="False"/>
                <Setter Property="IsSelectable" Value="{Binding IsSelectable}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="IsMovable" Value="{Binding IsMovable}"/>
                <Setter Property="sam:ZIndexLayerManger.ZIndexLayer" Value="{Binding LayerIndex}"/>
            </Style>
        </sam:SelectAndMove.Styles>
    </sam:SelectAndMove>
</UserControl>
