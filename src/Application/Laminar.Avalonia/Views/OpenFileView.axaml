<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Laminar.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:OpenFileViewModel"
             x:Class="Laminar.Avalonia.Views.OpenFileView">
    <Border Classes="UiLayer">
        <Panel Classes="UiLayer">
            <ContentControl Content="{Binding FileContents}"
                            IsVisible="{Binding FileContents, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ClipToBounds="True"/>
            <TextBlock IsVisible="{Binding FileContents, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="No File Open"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="h1"/>
        </Panel>
    </Border>
</UserControl>
