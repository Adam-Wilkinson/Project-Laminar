<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Laminar.Avalonia.ViewModels"
             xmlns:vms="using:Laminar.Avalonia.ViewModels.Services"
             xmlns:dvm="using:Laminar.Avalonia.ViewModels.Design"
             xmlns:t="using:Laminar.Avalonia.ToolSystem"
             xmlns:dd="using:Laminar.Avalonia.DragDrop"
             xmlns:conv="using:Laminar.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" d:DataContext="{x:Static dvm:DesignViewModel.FileNavigator}"
             x:DataType="vm:FileNavigatorViewModel"
             x:Class="Laminar.Avalonia.Views.FileNavigatorView"
             t:ToolMenu.ContextToolbox="{StaticResource FileNavigatorRightClick}">
    
    <UserControl.Resources>
        <t:Toolbox x:Key="FileNavigatorRightClick" NameKey="File Explorer" DataType="vm:FileNavigatorViewModel">
            <StaticResource ResourceKey="Tools.FileSystem.Browser.Refresh"/>
            <StaticResource ResourceKey="Tools.FileSystem.Browser.AddRootFolder"/>
        </t:Toolbox>
    </UserControl.Resources>
    
    <DockPanel MinWidth="1" Name="FileNavigator" VerticalAlignment="Stretch">
        <ItemsControl DockPanel.Dock="Bottom" Height="35" HorizontalAlignment="Center"
                      ItemsSource="{Binding 
                        Converter={StaticResource ToolInstancer},
                        ConverterParameter={StaticResource Tools.FileSystem.Browser}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        
        <TreeView ItemContainerTheme="{StaticResource DragDropTreeViewItemTheme}"
                  ItemsSource="{Binding RootFiles}" 
                  SelectionMode="Multiple"
                  dd:DropTargetHandler.DropAcceptor="{StaticResource TreeViewDropAcceptor}"
                  dd:DropTargetHandler.DropTarget="{Binding}"
                  VerticalAlignment="Stretch">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type vm:FileNavigatorItemViewModel}"
                                  ItemsSource="{Binding Children}">
                    <ContentControl Content="{Binding}"/>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FileNavigatorItemViewModel">
                    <Setter Property="vms:FocusedRuntimeManager.FocusRuntime" Value="{Binding RuntimeHost}"/>
                    
                    <Style Selector="^:empty /template/ Button#PART_ExpandCollapseChevron">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    
                    <Style Selector="^ /template/ Button#PART_ExpandCollapseChevron">
                        <Setter Property="Content">
                            <Template>
                                <PathIcon DataContext="{Binding $parent[TreeViewItem].((vm:FileNavigatorItemViewModel)DataContext)}">
                                    <PathIcon.Data>
                                        <MultiBinding Converter="{StaticResource SwitchConverter}" ConverterParameter="{StaticResource Icon.ExclamationMark}">
                                            <MultiBinding StringFormat="Expanded: {0}, Type: {1}">
                                                <Binding Path="IsExpanded"/>
                                                <Binding Path="Type.ItemTypeName" Converter="{StaticResource ToStringConverter}"/>
                                            </MultiBinding>
                                            <conv:SwitchItemBinding SwitchKey="Expanded: False, Type: Folder" Source="{StaticResource Icon.ClosedFolder}"/>
                                            <conv:SwitchItemBinding SwitchKey="Expanded: True, Type: Folder" Source="{StaticResource Icon.OpenFolder}"/>
                                            <conv:SwitchItemBinding SwitchKey="Expanded: False, Type: Script" Source="{StaticResource Icon.Script}"/>
                                            <conv:SwitchItemBinding SwitchKey="Expanded: True, Type: Script" Source="{StaticResource Icon.Script}"/>
                                        </MultiBinding>
                                    </PathIcon.Data>
                                </PathIcon>
                            </Template>
                        </Setter>
                    </Style>
                </Style>
            </TreeView.Styles>
        </TreeView>
    </DockPanel>
</UserControl>
