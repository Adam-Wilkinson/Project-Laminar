<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="using:Laminar.Avalonia.Settings"
                    xmlns:vm="using:Laminar.Avalonia.ViewModels"
                    xmlns:e="using:Echoes"
                    xmlns:lang="using:Laminar.Avalonia.Translations">
    <DataTemplate x:Key="PluginInfoDataTemplate" DataType="vm:PluginInfoViewModel">
        <Border Classes="UiLayer" Padding="3">
            <StackPanel>
                <Grid RowDefinitions="Auto"
                      ColumnDefinitions="*,*,Auto,Auto"
                      ColumnSpacing="3"
                      HorizontalAlignment="Stretch">
                    
                    <ToggleButton Name="ExpandToggle" Grid.Column="0" Grid.Row="0" 
                                  Theme="{StaticResource Themes.ExpandCollapseToggleButton}"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  Padding="2"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <TextBlock Text="{Binding TargetVersionName}"
                                   VerticalAlignment="Center"
                                   Classes="h2"/>
                    </ToggleButton>
                    
                    <ComboBox Grid.Row="0" Grid.Column="1" 
                              ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding TargetVersion, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>

                    <Button Grid.Row="0" Grid.Column="2" Theme="{StaticResource ToolButton}"
                            DataContext="{Binding Converter={StaticResource ToolInstancer},
                            ConverterParameter={StaticResource Tools.Settings.PluginTools.SetVersion}}"/>
                    
                    <Button Grid.Row="0" Grid.Column="3" Theme="{StaticResource ToolButton}"
                            IsVisible="{Binding $parent.((vm:PluginInfoViewModel)DataContext)?.IsInstalled, FallbackValue={x:False}}"
                            DataContext="{Binding Converter={StaticResource ToolInstancer},
                            ConverterParameter={StaticResource Tools.Settings.PluginTools.Uninstall}}"/>
                    
                </Grid>
                
                <LayoutTransformControl Name="InstallationsContainer" 
                                        Classes.ZeroHeight="{Binding !IsExpanded}">
                    <LayoutTransformControl.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="LayoutTransform" Duration="{s:Setting InterfaceSettings.AnimationDuration}"/>
                            <DoubleTransition Property="Opacity" Duration="{s:Setting InterfaceSettings.AnimationDuration}"></DoubleTransition>
                        </Transitions>
                    </LayoutTransformControl.Transitions>
                    <StackPanel Spacing="6" Margin="8,4,0,0">
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,0,0,5"
                                   Classes="b2"/>
                        <TextBlock Text="{e:Translate {x:Static lang:Strings.WorkspaceInfos}}"/>
                        <ItemsControl ItemsSource="{Binding Workspaces}"
                                      Margin="10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto" ColumnDefinitions="*,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding HostName}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}"/>
                                        <Border Grid.Column="2"
                                                Background="Transparent"
                                                ToolTip.Tip="{e:Translate {x:Static lang:Strings.PluginVersionCorrect}}">
                                            <Button Theme="{StaticResource ToolButton}"
                                                    DataContext="{Binding Converter={StaticResource ToolInstancer}, 
                                                    ConverterParameter={StaticResource Tools.Settings.PluginTools.SetVersion}}"/>
                                        </Border>
                                        <Button Grid.Column="3" Theme="{StaticResource ToolButton}"
                                                DataContext="{Binding Converter={StaticResource ToolInstancer},
                                                ConverterParameter={StaticResource Tools.Settings.PluginTools.Uninstall}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </LayoutTransformControl>
            </StackPanel>
            
            <Border.Styles>
                <Style Selector="LayoutTransformControl#InstallationsContainer.ZeroHeight">
                    <Setter Property="LayoutTransform" Value="scaley(0)"/>
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                
                <Style Selector="LayoutTransformControl#InstallationsContainer">
                    <Setter Property="LayoutTransform" Value="scaley(1)"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>
        </Border>
    </DataTemplate>
</ResourceDictionary>
